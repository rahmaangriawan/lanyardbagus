---
import '../styles/global.css';
import { Toaster } from 'svelte-sonner';

interface Props {
  seoGlobal?: Record<string, any> | null;
}

const { seoGlobal = null } = Astro.props;
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {seoGlobal?.google_site_verification && (
    <meta name="google-site-verification" content={seoGlobal.google_site_verification} />
  )}
  {seoGlobal?.bing_site_verification && (
    <meta name="msvalidate.01" content={seoGlobal.bing_site_verification} />
  )}
  <slot name="head" />
</head>
<body>
  <Toaster position="top-right" richColors client:load />
  <slot />
</body>
</html>
